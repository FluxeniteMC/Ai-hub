# Copy this to .env and fill in your keys
# NEVER commit .env to git

# Required: Get from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# v2.0: what the self-editing updater touches (all | pricing | new_apis | deprecations | descriptions)
UPDATE_TYPE=all

# Optional: which Gemini model to use (default: gemini-3-flash-preview)
GEMINI_MODEL=gemini-3-flash-preview

# Optional: daily or weekly digest (used by the report script)
REPORT_PERIOD=daily

# ---------------------------------------------------------------------------
# Catalog providers (v2.1)
# ---------------------------------------------------------------------------
# Groq. OPTIONAL - the catalog workflow skips the Groq fetch and reuses the last
# known good data/groq.json when this is absent. Without it the site still
# builds and every other source still refreshes.
# Get one from https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter's /api/v1/models endpoint is public and needs no key, so there is
# no OPENROUTER_API_KEY here by design. Adding a key would only raise the rate
# limit on a public endpoint this project does not need to call differently.

# ---------------------------------------------------------------------------
# Coding agent (v2.1)
# ---------------------------------------------------------------------------
# The coding agent refuses to push to `main` unless this is explicitly set to 1.
# Leave it unset: work belongs on a feature branch and a pull request.
# AGENT_ALLOW_MAIN_PUSH=1