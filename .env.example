# Copy this to .env and fill in your keys
# NEVER commit .env to git

# Required: Get from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# v2.0: what the self-editing updater touches (all | pricing | new_apis | deprecations | descriptions)
UPDATE_TYPE=all

# Optional: which Gemini model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: daily or weekly digest (used by the report script)
REPORT_PERIOD=daily
